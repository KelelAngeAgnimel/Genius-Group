# Copier ce fichier en .env (non commité) et renseigner les valeurs.
# Ne JAMAIS mettre de vraie valeur dans ce fichier.

# Port d'écoute (Render le fournit automatiquement)
PORT=3001

# Supabase : URL du projet et clé service_role (backend uniquement, jamais côté frontend)
SUPABASE_URL=
SUPABASE_KEY=

# Secret de signature des JWT (chaîne aléatoire longue, ex. 64 caractères)
JWT_SECRET=

# Clé API Groq (chatbot et génération de quiz)
GROQ_API_KEY=
